# Simple proxy (one fixed endpoint)
# protocol: http | https | socks4 | socks5
PROXY_PROTOCOL=http
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Rotating residential (sticky session per browser context) — use INSTEAD of the above
# PROXY_STRATEGY=backconnect
# PROXY_BACKCONNECT_HOST=gate.provider.com
# PROXY_BACKCONNECT_PORT=7000
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_SESSION_DURATION_MINUTES=10

# Geo-targeting (provider must support it)
# PROXY_COUNTRY=NL
# PROXY_CITY=rotterdam
